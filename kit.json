  {
   "id": "building",
   "type": "terminal",
   "title": {
    "en": "how I use them",
    "es": "cómo los uso"
   },
   "lines": [
    "$ reporinse install --provider git --all --yes",
    {
     "en": "# no more AI co-author lines in my commits",
     "es": "# adiós a las firmas de IA en mis commits"
    },
    "$ reporinse install --provider opencode,deepseek --all --yes",
    {
     "en": "# stop agents from running what they shouldn't",
     "es": "# que los agentes no corran lo que no deben"
    },
    "$ rekora agent install claude --confirm",
    {
     "en": "# so Claude remembers what we already decided",
     "es": "# para que Claude recuerde lo que ya decidimos"
    }
   ]
  },
