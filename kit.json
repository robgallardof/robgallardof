    {"id": "h-about", "type": "heading", "number": "01", "icon": "lucide-brain-circuit",
     "kicker": {"en": "About", "es": "Sobre mí"},
     "title": {"en": "I read the legacy code before judging it", "es": "Leo el código legacy antes de juzgarlo"}},
    {"id": "about", "type": "bento", "cells": [
      {"span": 2, "icon": "lucide-briefcase-business", "kicker": {"en": "By day", "es": "De día"},
       "title": {"en": "Backend services in .NET", "es": "Servicios backend en .NET"},
       "text": {"en": "For a global logistics company: APIs, integrations and the migrations nobody else wants to touch.", "es": "Para una empresa global de logística: APIs, integraciones y las migraciones que nadie más quiere tocar."}},
      {"icon": "clock", "kicker": {"en": "Every generation", "es": "Todas las versiones"},
       "title": ".NET 2.0 → 11",
       "text": {"en": "Framework 2.0 / 3.5 / 4.x, .NET Core and .NET 5 → 11.", "es": "Framework 2.0 / 3.5 / 4.x, .NET Core y .NET 5 → 11."}},
      {"icon": "lucide-bot", "kicker": {"en": "4 years with AI", "es": "4 años con IA"},
       "title": {"en": "Reviewed, never blind", "es": "Con revisión, no a ciegas"},
       "text": {"en": "From ChatGPT to Codex, Claude Code and Antigravity.", "es": "De ChatGPT a Codex, Claude Code y Antigravity."}},
      {"span": 2, "icon": "lucide-sparkles", "kicker": {"en": "By night", "es": "De noche"},
       "title": {"en": "AI agents that do real work", "es": "Agentes de IA que hacen trabajo real"},
       "text": {"en": "They edit my videos, publish them and even do my taxes. Locally, with me in control.", "es": "Editan mis videos, los publican y hasta hacen mi declaración. En local, conmigo al mando."}},
      {"span": 2, "icon": "lucide-graduation-cap", "kicker": {"en": "Education", "es": "Formación"},
       "title": {"en": "MSc in Software Architecture", "es": "Maestría en Arquitectura de Software"},
       "text": {"en": "Plus a Bachelor's in Administrative Computer Systems. Based in Guadalajara, Jalisco.", "es": "Y licenciatura en Sistemas Computacionales Administrativos. Desde Guadalajara, Jalisco."}},
      {"icon": "lucide-code-xml", "kicker": {"en": "Ask me about", "es": "Pregúntame de"},
       "title": {"en": "C#, migrations, design", "es": "C#, migraciones, diseño"},
       "text": {"en": "MongoDB, Vue / Next.js, DevOps and AI agents.", "es": "MongoDB, Vue / Next.js, DevOps y agentes de IA."}}
    ]},

    {"id": "h-building", "type": "heading", "number": "02", "icon": "lucide-wand-sparkles",
     "kicker": {"en": "Building now", "es": "Construyendo"},
     "title": {"en": "Local tools for AI coding agents", "es": "Herramientas locales para agentes de código"}},
    {"id": "building", "type": "terminal", "title": {"en": "three commands, three jobs", "es": "tres comandos, tres trabajos"}, "lines": [
      "$ reporinse install --provider git --all --yes",
      {"en": "# clean every commit message", "es": "# limpia cada mensaje de commit"},
      "$ reporinse install --provider opencode,deepseek --all --yes",
      {"en": "# guardrails for your agents", "es": "# límites para tus agentes"},
      "$ rekora agent install claude --confirm",
      {"en": "# give Claude Code a memory", "es": "# dale memoria a Claude Code"}
    ]},

    {"id": "h-projects", "type": "heading", "number": "03", "icon": "lucide-folder-code",
     "kicker": {"en": "Projects", "es": "Proyectos"},
     "title": {"en": "Things I built and use every week", "es": "Cosas que construí y uso cada semana"}},
    {"id": "projects", "type": "cards", "items": [
      {"title": "Rekora", "href": "https://github.com/robgallardof/rekora", "icon": "lucide-brain-circuit", "badge": {"en": "New", "es": "Nuevo"},
       "kicker": {"en": "Agent memory", "es": "Memoria para agentes"}, "tags": ["Rust", "MCP", "SQLite"],
       "text": {"en": "Local-first, verifiable memory for AI coding agents: decisions with their sources, stale detection, tasks and handoffs between Claude Code, Codex, OpenCode and DeepSeek Harness.",
                "es": "Memoria local y verificable para agentes de código: decisiones con sus fuentes, detección de desactualizados, tareas y handoffs entre Claude Code, Codex, OpenCode y DeepSeek Harness."}},
      {"title": "RepoRinse", "href": "https://github.com/robgallardof/RepoRinse", "icon": "lucide-shield-check", "badge": {"en": "New", "es": "Nuevo"},
       "kicker": {"en": "Git and agent hooks", "es": "Hooks de Git y agentes"}, "tags": ["Rust", "Git hooks", "Agent hooks"],
       "text": {"en": "Keeps repos clean and agents in check: removes AI co-author trailers (keeps the humans), whitespace and invisible Unicode, and adds guardrail hooks for six agents.",
                "es": "Mantiene limpios los repos y a los agentes bajo control: quita trailers de coautoría de IA (respeta a las personas), espacios e Unicode invisible, y agrega hooks para seis agentes."}},
      {"title": "davinci-resolve-mcp", "href": "https://github.com/robgallardof/davinci-resolve-mcp", "icon": "lucide-clapperboard",
       "kicker": {"en": "Video editing", "es": "Edición de video"}, "tags": ["MCP", "Python", "Video"],
       "text": {"en": "Edit in DaVinci Resolve by talking to an AI producer: vertical and horizontal cuts, motion that keeps faces whole, designed captions, music on the beat and QA before every render.",
                "es": "Edita en DaVinci Resolve hablando con un productor de IA: cortes verticales y horizontales, movimiento que no corta caras, subtítulos con diseño, música a tiempo y QA antes de cada render."}},
      {"title": "social-publisher-mcp", "href": "https://github.com/robgallardof/social-publisher-mcp", "icon": "lucide-send",
       "kicker": {"en": "Publishing", "es": "Publicación"}, "tags": ["MCP", "Python", "Social"],
       "text": {"en": "An AI community manager for short-form video: watches your videos, writes the copy for every network, schedules the posts and tells you what worked.",
                "es": "Un community manager con IA para video corto: ve tus videos, escribe el texto de cada red, programa las publicaciones y te dice qué funcionó."}},
      {"title": "declaracion", "href": "https://github.com/robgallardof/declaracion", "icon": "lucide-receipt-text",
       "kicker": {"en": "Mexican taxes", "es": "Impuestos en México"}, "tags": ["MCP", "Python", "SAT"],
       "text": {"en": "A personal tax assistant for Mexico inside your AI agent: reads CFDI, computes ISR and IVA (RESICO) and guides the filing. Your data stays on your PC.",
                "es": "Tu asistente de impuestos personales en México dentro de tu agente: lee CFDI, calcula ISR e IVA (RESICO) y te guía al declarar. Tus datos se quedan en tu PC."}},
      {"title": "Agent Mods", "href": "https://github.com/robgallardof/agent-mods", "icon": "lucide-panels-top-left",
       "kicker": {"en": "Claude Code mods", "es": "Mods de Claude Code"}, "tags": ["Native mods", "Claude Code"],
       "text": {"en": "See what your coding session is using: context, cost, quotas, Git branch, MCP tools, memory and tool activity. Install only the displays you want.",
                "es": "Mira qué usa tu sesión de código: contexto, costo, cuotas, rama de Git, herramientas MCP, memoria y actividad. Instala solo las vistas que quieras."}},
      {"title": "readme-builder", "href": "https://github.com/robgallardof/readme-builder", "icon": "lucide-layout-template",
       "kicker": {"en": "README design system", "es": "Sistema visual de README"}, "tags": ["Python", "SVG", "Offline"],
       "text": {"en": "The kit behind this page: buttons, cards, wave dividers, headings and an offline generator. Original SVGs, no services, no tracking.",
                "es": "El kit detrás de esta página: botones, tarjetas, separadores, encabezados y un generador offline. SVG propios, sin servicios ni rastreo."}},
      {"title": "wikdoc", "href": "https://github.com/robgallardof/wikdoc", "icon": "lucide-book-open",
       "kicker": {"en": "Local RAG", "es": "RAG local"}, "tags": ["Python", "Ollama", "RAG"],
       "text": {"en": "Turn any folder of code into a local knowledge base you can chat with. Embeddings and RAG over Ollama; nothing leaves your machine.",
                "es": "Convierte cualquier carpeta de código en una base de conocimiento local con la que puedes chatear. Embeddings y RAG con Ollama; nada sale de tu equipo."}},
      {"title": "wallybot", "href": "https://github.com/robgallardof/wallybot", "icon": "lucide-chart-no-axes-combined",
       "kicker": {"en": "Self-hosted trading hub", "es": "Trading autoalojado"}, "tags": ["Python", "Next.js", "Self-hosted"],
       "text": {"en": "Market analysis, portfolio and AI-assisted trading: explained proposals, your approval and risk controls.",
                "es": "Análisis de mercado, portafolio y trading asistido por IA: propuestas explicadas, tu aprobación y controles de riesgo."}},
      {"title": "multig", "href": "https://github.com/robgallardof/multig", "icon": "lucide-blocks",
       "kicker": {"en": "Browser profiles", "es": "Perfiles de navegador"}, "tags": ["Next.js", "Python", "Camoufox"],
       "text": {"en": "Manage many persistent, isolated browser profiles with Camoufox, a Next.js dashboard and a Python backend.",
                "es": "Administra muchos perfiles de navegador persistentes y aislados con Camoufox, un panel en Next.js y un backend en Python."}}
    ]},
