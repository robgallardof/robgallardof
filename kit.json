    {
     "icon": "clock",
     "kicker": {
      "en": "Since 2.0",
      "es": "Desde la 2.0"
     },
     "title": ".NET 2.0 → 11",
     "text": {
      "en": "I started on Framework 2.0 and I've migrated pretty much every version since.",
      "es": "Empecé con Framework 2.0 y he migrado casi todas las versiones desde entonces."
     }
    },
    {
     "icon": "lucide-bot",
     "kicker": {
      "en": "AI",
      "es": "IA"
     },
     "title": {
      "en": "Every day, since 2022",
      "es": "A diario, desde 2022"
     },
     "text": {
      "en": "Mostly Codex and Claude Code now. I still read everything they write.",
      "es": "Ahora sobre todo Codex y Claude Code. Igual leo todo lo que escriben."
