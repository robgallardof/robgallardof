   "items": [
    {
     "title": "Rekora",
     "href": "https://github.com/robgallardof/rekora",
     "icon": "lucide-brain-circuit",
     "badge": {
      "en": "New",
      "es": "Nuevo"
     },
     "kicker": {
      "en": "Agent memory",
      "es": "Memoria para agentes"
     },
     "tags": [
      "Rust",
      "MCP",
      "SQLite"
     ],
     "text": {
      "en": "Memory for coding agents. It keeps decisions and where they came from, warns you when something is out of date, and lets Claude Code, Codex and others hand work to each other.",
      "es": "Memoria para agentes de código. Guarda decisiones y de dónde salieron, avisa cuando algo ya no aplica y deja que Claude Code, Codex y otros se pasen el trabajo."
     }
    },
    {
     "title": "RepoRinse",
     "href": "https://github.com/robgallardof/RepoRinse",
     "icon": "lucide-shield-check",
     "badge": {
      "en": "New",
      "es": "Nuevo"
     },
     "kicker": {
      "en": "Git and agent hooks",
      "es": "Hooks de Git y agentes"
     },
     "tags": [
      "Rust",
      "Git hooks",
      "Agent hooks"
     ],
     "text": {
      "en": "I got tired of AI tools signing my commits. This cleans them up (human co-authors stay) and adds hooks so agents don't run things they shouldn't.",
      "es": "Me cansé de que las herramientas de IA firmaran mis commits. Esto los limpia (los coautores humanos se quedan) y agrega hooks para que los agentes no hagan de las suyas."
     }
    },
    {
     "title": "Qualyx",
     "href": "https://github.com/robgallardof/qualyx",
     "icon": "lucide-scan-eye",
     "badge": {
      "en": "New",
      "es": "Nuevo"
     },
     "kicker": {
      "en": "Testing and QA",
      "es": "Pruebas y QA"
     },
     "tags": [
      "Rust",
      "MCP",
      "Next.js"
     ],
     "text": {
      "en": "Finds a project's tests, runs them with its own tools (cargo, dotnet, npm, pytest) and keeps the evidence. I use it from the terminal, through an agent over MCP, or in a small web console.",
      "es": "Encuentra las pruebas de un proyecto, las corre con sus propias herramientas (cargo, dotnet, npm, pytest) y guarda la evidencia. Lo uso desde la terminal, con un agente por MCP o en una consola web."
     }
    },
    {
     "title": "davinci-resolve-mcp",
     "href": "https://github.com/robgallardof/davinci-resolve-mcp",
     "icon": "lucide-clapperboard",
     "kicker": {
      "en": "Video editing",
      "es": "Edición de video"
     },
     "tags": [
      "MCP",
      "Python",
      "Video"
     ],
     "text": {
      "en": "I edit my videos in DaVinci Resolve by talking to an agent. It cuts vertical and horizontal versions, adds captions, follows the music and checks everything before rendering.",
      "es": "Edito mis videos en DaVinci Resolve hablándole a un agente. Saca versiones vertical y horizontal, pone subtítulos, sigue la música y revisa todo antes de renderizar."
     }
    },
    {
     "title": "social-publisher-mcp",
     "href": "https://github.com/robgallardof/social-publisher-mcp",
     "icon": "lucide-send",
     "kicker": {
      "en": "Publishing",
      "es": "Publicación"
     },
     "tags": [
      "MCP",
      "Python",
      "Social"
     ],
     "text": {
      "en": "Watches my videos, writes the post for each network, schedules them and later tells me what worked. Basically my community manager.",
      "es": "Ve mis videos, escribe el texto de cada red, los programa y después me dice qué funcionó. Básicamente mi community manager."
     }
    },
    {
     "title": "declaracion",
     "href": "https://github.com/robgallardof/declaracion",
     "icon": "lucide-receipt-text",
     "kicker": {
      "en": "Mexican taxes",
      "es": "Impuestos en México"
     },
     "tags": [
      "MCP",
      "Python",
      "SAT"
     ],
     "text": {
      "en": "I do my monthly Mexican tax return with this. It reads my CFDI, works out ISR and IVA under RESICO and walks me through the SAT portal. Nothing leaves my PC.",
      "es": "Con esto hago mi declaración mensual. Lee mis CFDI, calcula ISR e IVA en RESICO y me guía en el portal del SAT. Nada sale de mi PC."
     }
    },
    {
     "title": "Agent Mods",
     "href": "https://github.com/robgallardof/agent-mods",
     "icon": "lucide-panels-top-left",
     "kicker": {
      "en": "Claude Code mods",
      "es": "Mods de Claude Code"
     },
     "tags": [
      "Native mods",
      "Claude Code"
     ],
     "text": {
      "en": "Small displays inside Claude Code: how much context and money I've used, quotas, the Git branch, which tools are on. Install only the ones you like.",
      "es": "Pequeñas vistas dentro de Claude Code: cuánto contexto y dinero llevo, cuotas, la rama de Git, qué herramientas hay. Instala solo las que te gusten."
     }
    },
    {
     "title": "readme-builder",
     "href": "https://github.com/robgallardof/readme-builder",
     "icon": "lucide-layout-template",
     "kicker": {
      "en": "README design system",
      "es": "Sistema visual de README"
     },
     "tags": [
      "Python",
      "SVG",
      "Offline"
     ],
     "text": {
      "en": "What I used to make this page: the buttons, the cards, the wavy separators. Just SVG files, no outside services.",
      "es": "Con lo que hice esta página: los botones, las tarjetas, los separadores de onda. Puros archivos SVG, sin servicios externos."
     }
    },
    {
     "title": "wikdoc",
     "href": "https://github.com/robgallardof/wikdoc",
     "icon": "lucide-book-open",
     "kicker": {
      "en": "Local RAG",
      "es": "RAG local"
     },
     "tags": [
      "Python",
      "Ollama",
      "RAG"
     ],
     "text": {
      "en": "Point it at a folder of code and chat with it. It runs on Ollama, so nothing leaves your computer.",
      "es": "Apúntalo a una carpeta de código y platica con él. Corre con Ollama, así que nada sale de tu compu."
     }
    },
    {
     "title": "wallybot",
     "href": "https://github.com/robgallardof/wallybot",
     "icon": "lucide-chart-no-axes-combined",
     "kicker": {
      "en": "Self-hosted trading hub",
      "es": "Trading autoalojado"
     },
     "tags": [
